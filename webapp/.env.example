# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GASCHECK MQTT & BACKEND CONFIGURATION
MQTT_BROKER_URL="mqtt://broker.hivemq.com:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_TOPIC_TELEMETRY="gascheck/n19/telemetry"
MQTT_TOPIC_EVENT="gascheck/n19/event"
MQTT_TOPIC_STATUS="gascheck/n19/status"
MQTT_TOPIC_CMD="gascheck/n19/cmd"
GASCHECK_DEFAULT_MODE="DEMO"
GASCHECK_STALE_TIMEOUT_MS="15000"
GASCHECK_WARNING_THRESHOLD="1500"
GASCHECK_DANGER_THRESHOLD="2400"

